<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ReNUnite" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/background_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Background color. -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">#1E293B</item>

        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>

        <item name="materialAlertDialogTheme">@style/BrandedAlertDialog</item>

        <!-- Custom attributes for homepage elements -->
        <item name="homeCardBackground">@color/brand_blue_accent</item>
    </style>

    <style name="Theme.ReNUnite.Splash" parent="Theme.ReNUnite">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="BrandedAlertDialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="shapeAppearanceOverlay">@style/DialogCorners</item>
        <item name="materialAlertDialogTitleTextStyle">@style/BrandedDialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/BrandedDialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/BrandedDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/BrandedDialogButtonSecondary</item>
        <item name="android:backgroundTint">@color/white</item>
    </style>

    <style name="DialogCorners">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">40dp</item>
    </style>

    <style name="BrandedDialogTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">#4361B5</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="BrandedDialogBody" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">#A0ACCF</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="BrandedDialogButton" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">#6A9EF8</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">54dp</item>
    </style>

    <style name="BrandedDialogButtonSecondary" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">#A0ACCF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="DateChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/input_field_bg</item>
        <item name="android:backgroundTint">@color/background_light</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="TimeChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/input_field_bg</item>
        <item name="android:backgroundTint">@color/background_light</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
