<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReNUnite">
        <activity
            android:name="com.example.renunite.ReportFoundActivity"
            android:exported="false" />
        <activity
            android:name="com.example.renunite.ReportLostActivity"
            android:exported="false" />
        <activity
            android:name="com.example.renunite.HomeActivity"
            android:exported="false" />
        <activity
            android:name="com.example.renunite.CreateAccountActivity"
            android:exported="false" />
        <activity
            android:name="com.example.renunite.LoginActivity"
            android:exported="false" />
        <activity
            android:name="com.example.renunite.MainActivity"
            android:exported="false" />
        <activity
            android:name="com.example.renunite.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ReNUnite.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>